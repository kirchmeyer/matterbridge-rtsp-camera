{
  "type": "object",
  "required": ["mode", "cameras"],
  "properties": {
    "mode": {
      "title": "Camera protocol",
      "type": "string",
      "enum": ["matter", "homekit"],
      "enumNames": ["Matter (Matter 1.5)", "Apple Home (HomeKit)"],
      "default": "matter"
    },
    "go2rtcUrl": {
      "title": "go2rtc API URL (Matter mode only)",
      "type": "string",
      "default": "http://127.0.0.1:1984"
    },
    "homekitPin": {
      "title": "Apple Home pairing code (HomeKit mode only)",
      "type": "string",
      "pattern": "^[0-9]{3}-[0-9]{2}-[0-9]{3}$",
      "default": "031-45-154"
    },
    "cameras": {
      "title": "Cameras",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rtspUrl"],
        "properties": {
          "id": { "title": "Stable ID", "type": "string", "minLength": 1 },
          "name": { "title": "Name", "type": "string", "minLength": 1 },
          "rtspUrl": { "title": "RTSP URL", "type": "string", "pattern": "^rtsps?://" },
          "homekitPort": {
            "title": "HomeKit port",
            "description": "HomeKit mode only: the TCP port this camera listens on, 1024 to 65535, different for each camera. Leave empty for a free port picked at every start (pairing works either way: the port is advertised over mDNS); set it to keep the port across restarts, for a firewall rule between networks.",
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        }
      }
    }
  }
}